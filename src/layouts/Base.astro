---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
}
const { title, description, lang = 'en' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieConsent lang={lang} />

    <!-- Smooth scroll (Lenis) + scroll-reveal. Progressive enhancement:
         nothing here is required for content to be visible/accessible. -->
    <script>
      import Lenis from 'lenis';

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const supportsIO = 'IntersectionObserver' in window;

      if (!reduce && supportsIO) {
        // Reveal-on-scroll
        document.documentElement.classList.add('js-reveal');
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.12 },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
        // Safety net: never leave content hidden if something stalls.
        window.setTimeout(() => {
          document
            .querySelectorAll('[data-reveal]:not(.is-visible)')
            .forEach((el) => {
              const r = el.getBoundingClientRect();
              if (r.top < window.innerHeight) el.classList.add('is-visible');
            });
        }, 2500);

        // Buttery inertia scroll
        const lenis = new Lenis({
          duration: 1.1,
          easing: (t) => 1 - Math.pow(1 - t, 3), // ease-out cubic, no bounce
        });
        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);

        // In-page anchor links scroll smoothly through Lenis
        document.querySelectorAll('a[href^="#"]').forEach((a) => {
          a.addEventListener('click', (ev) => {
            const href = a.getAttribute('href');
            if (href && href.length > 1) {
              const target = document.querySelector(href);
              if (target) {
                ev.preventDefault();
                lenis.scrollTo(target as HTMLElement, { offset: -72 });
              }
            }
          });
        });
      }
    </script>

    <!-- Cal.com element-click embed init (buttons carry data-cal-* attributes) -->
    <script is:inline>
      (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
      Cal("init", "30min", { origin: "https://app.cal.com" });
      Cal.ns["30min"]("ui", { hideEventTypeDetails: false, layout: "month_view" });
    </script>

    <style>
      /* Header is fixed/out of flow, so page content needs a top offset to
         clear it. The hero (if present) cancels this with a negative margin
         so its own background still reaches the true top of the page. */
      main { padding-top: var(--header-h); }

      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--color-brand);
        color: #fff;
        padding: 0.75rem 1rem;
        border-radius: 0 0 var(--radius-sm) 0;
        z-index: 200;
      }
      .skip-link:focus { left: 0; }
    </style>
  </body>
</html>
