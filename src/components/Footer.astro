---
import Logo from './Logo.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { estimatorCopy, estimatorHref } from '../i18n/estimator';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const home = lang === 'en' ? '/' : `/${lang}/`;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const onHome = pathname === (home.replace(/\/$/, '') || '/');
const sectionHref = (id: string) => onHome ? `#${id}` : `${home}#${id}`;

const nav = [
  { href: sectionHref('problem'), label: t('nav.problem') },
  { href: sectionHref('approach'), label: t('nav.approach') },
  { href: sectionHref('compliance'), label: t('nav.compliance') },
  { href: sectionHref('contact'), label: t('nav.contact') },
  { href: estimatorHref(lang), label: estimatorCopy[lang === 'de' ? 'de' : 'en']['nav.label'] },
];
const legal = [
  { href: `${home}impressum/`, label: t('legal.imprint') },
  { href: `${home}datenschutz/`, label: t('legal.privacy') },
];
---
<footer class="site-footer">
  <div class="container-page site-footer__inner">
    <div class="site-footer__brand">
      <Logo class="logo" />
      <p class="site-footer__tagline">{t('footer.tagline')}</p>
      <a href="mailto:info@onsano.com" class="site-footer__email">info@onsano.com</a>
    </div>

    <nav class="site-footer__col" aria-label="Sections">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <nav class="site-footer__col" aria-label="Legal">
      {legal.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>

  <div class="container-page site-footer__base">
    <span>© {year} Onsano. {t('footer.rights')}</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--spacing-section);
    border-top: 1px solid var(--color-border);
    padding-top: clamp(3rem, 2rem + 4vw, 5rem);
    padding-bottom: 2.5rem;
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .site-footer__brand { max-width: 22rem; color: var(--color-brand); }
  .site-footer__tagline {
    margin-top: 1rem;
    color: var(--color-muted);
    font-size: 0.95rem;
  }
  .site-footer__email {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--color-brand);
    text-decoration: none;
    font-weight: 500;
  }
  .site-footer__email:hover { text-decoration: underline; }

  .site-footer__col { display: flex; flex-direction: column; gap: 0.75rem; }
  /* Same cue as the header nav: a hairline underline grows in from the center. */
  .site-footer__col a {
    position: relative;
    display: inline-block;
    width: fit-content;
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.95rem;
    padding-bottom: 0.2rem;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .site-footer__col a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 1px;
    background: var(--color-brand-green);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .site-footer__col a:hover,
  .site-footer__col a:focus-visible { color: var(--color-brand); }
  .site-footer__col a:hover::after,
  .site-footer__col a:focus-visible::after {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-footer__col a::after { transition: none; }
  }

  .site-footer__base {
    margin-top: 3rem;
    color: var(--color-muted);
    font-size: 0.8125rem;
  }

  @media (min-width: 720px) {
    .site-footer__inner {
      grid-template-columns: 2fr 1fr 1fr;
      gap: 3rem;
    }
  }
</style>
