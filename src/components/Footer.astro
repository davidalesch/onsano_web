---
import Logo from "./Logo.astro";
import { useTranslations, type Lang } from "../i18n/ui";
import { productCopy } from "../i18n/product";
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const c = productCopy(lang);
const home = lang === "en" ? "/" : `/${lang}/`;
---

<footer class="rev-footer">
  <div class="footer-top">
    <div>
      <a href={home} aria-label="Onsano home">
        <Logo class="logo" />
      </a>
      <p>{c.footer}</p>
    </div>
    <nav aria-label="Products">
      <a href={`${home}#md-agent`}>{c.md}</a>
      <a href={`${home}#widerspruch-agent`}>{c.objection}</a>
      <a href={`${home}#compliance`}>{c.trust}</a>
      <a href={lang === "de" ? "/de/verlustrechner/" : "/loss-estimator/"}>
        {lang === "de" ? "Verlustrechner" : "Loss estimator"}
      </a>
    </nav>
    <div class="footer-contact">
      <span>{c.footerConversation}</span>
      <a href="mailto:info@onsano.com">info@onsano.com ↗</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Onsano</span>
    <nav aria-label="Legal">
      <a href={`${home}impressum/`}>{t("legal.imprint")}</a>
      <a href={`${home}datenschutz/`}>{t("legal.privacy")}</a>
    </nav>
    <span>{c.footerCare}</span>
  </div>
</footer>
<style>
  .rev-footer {
    max-width: 1344px;
    margin: auto;
    padding: 65px 48px 25px;
    font-size: 12px;
    color: #273f4b;
  }
  .rev-footer a {
    color: inherit;
    text-decoration: none;
  }
  .rev-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 55px;
  }
  .footer-top :global(.logo) {
    height: 44px;
    --logo-gap: #faf9f5;
  }
  .footer-top p {
    white-space: pre-line;
    line-height: 1.6;
    color: #5b6e76;
    margin: 20px 0 0;
  }
  .footer-top nav {
    display: flex;
    flex-direction: column;
    gap: 13px;
    padding-top: 5px;
  }
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 15px;
    padding-top: 5px;
  }
  .footer-contact span {
    color: #5b6e76;
    font-size: 11px;
  }
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-top: 1px solid #dce1de;
    padding-top: 22px;
    font-size: 9px;
    color: #65757a;
  }
  .footer-bottom nav {
    display: flex;
    gap: 25px;
  }
  @media (max-width: 760px) {
    .rev-footer {
      padding: 50px 26px 25px;
    }
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 35px;
    }
    .footer-contact {
      grid-column: 1/-1;
    }
    .footer-bottom {
      flex-wrap: wrap;
    }
    .footer-bottom > span:last-child {
      display: none;
    }
  }
  @media (max-width: 400px) {
    .footer-top {
      font-size: 11px;
    }
    .footer-bottom nav {
      gap: 15px;
    }
  }
</style>
