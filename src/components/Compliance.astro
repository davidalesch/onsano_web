---
import { ShieldCheck, UserCheck, FileCheck } from 'lucide-astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const items = [
  { icon: ShieldCheck, title: t('compliance.item1.title'), body: t('compliance.item1.body') },
  { icon: UserCheck, title: t('compliance.item2.title'), body: t('compliance.item2.body') },
  { icon: FileCheck, title: t('compliance.item3.title'), body: t('compliance.item3.body') },
];
---
<section id="compliance" class="compliance">
  <div class="container-page compliance__inner">
    <p class="compliance__kicker sd-rise" style="--sd-range: entry 1% cover 16%">{t('compliance.kicker')}</p>
    <h2 class="compliance__title sd-rise" style="--sd-range: entry 3% cover 22%">{t('compliance.title')}</h2>

    <div class="compliance__grid">
      {items.map((item, i) => (
        <div class="compliance__card sd-rise" style={`--sd-range: entry ${8 + i * 3}% cover ${28 + i * 3}%`}>
          <div class="compliance__icon" aria-hidden="true">
            <item.icon width={22} height={22} stroke-width={1.75} />
          </div>
          <h3 class="compliance__card-title">{item.title}</h3>
          <p class="compliance__card-body">{item.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .compliance { padding-block: var(--spacing-section); }
  .compliance__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .compliance__kicker {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-green-ink);
    margin: 0 0 1rem;
  }
  .compliance__title {
    font-size: var(--text-h2);
    line-height: 1.15;
    max-width: 24ch;
    margin: 0 0 clamp(2.5rem, 5vw, 4rem);
  }

  .compliance__grid {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    text-align: left;
  }
  .compliance__card {
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .compliance__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius);
    background: var(--color-brand-100);
    color: var(--color-brand);
    margin-bottom: 1.25rem;
  }
  .compliance__card-title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-brand);
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
  }
  .compliance__card-body {
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
  }

  @media (min-width: 780px) {
    .compliance__grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
