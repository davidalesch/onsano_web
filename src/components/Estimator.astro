---
/**
 * Public loss estimator. The gated dashboard's (/dashboard) loss method with
 * no hospital data in it: the reader enters their own audit volume and
 * uncontested rate, and every published figure comes from src/lib/loss-model.ts.
 *
 * Uses the landing page's warm paper, sage surfaces and rounded cards, while
 * retaining semantic colours for loss and revenue potential.
 *
 * Structure is deliberately plain: step 1 (inputs, left) and step 2 (result,
 * right), each in its own labelled card. Nothing on the result side is
 * editable and nothing on the input side is an output.
 */
import { ArrowUpRight } from "lucide-astro";
import { estimatorCopy, type EstimatorLang } from "../i18n/estimator";
import { useTranslations } from "../i18n/ui";
import { STATES, IMPROVEMENT_PP } from "../lib/loss-model";

interface Props {
  lang: EstimatorLang;
}
const { lang } = Astro.props;
const c = estimatorCopy[lang];
const t = useTranslations(lang);
const pct = (n: number) => (lang === "de" ? `${n} %` : `${n}%`);

// Prefilled with the national picture so the result is never empty on load.
// Audits: mean per hospital 2025 (§ 275c Abs. 4 SGB V). Beds: Destatis 2024,
// 472,900 beds / 1,841 hospitals. Quote: nationwide, Q2 2026.
const DEFAULT_AUDITS = lang === "de" ? "730" : "730";
const DEFAULT_BEDS = "257";
const DEFAULT_QUOTE = lang === "de" ? "49,5" : "49.5";
const UNCAPPED_OPTIONS = [40, 50, 60, 80, 100];
---

<div class="est" data-estimator data-lang={lang}>
  <div class="est__app">
    <header class="est-masthead">
      <div class="est-masthead__text">
        <span class="est-eyebrow">{c.eyebrow}</span>
        <h1 class="est-title">{c.title}</h1>
        <p class="est-subtitle">{c.subtitle}</p>
      </div>
      <p class="est-masthead__meta">{c.dataAsOf}</p>
    </header>

    <div class="est-grid">
      <!-- ============ 1 · INPUT ============ -->
      <form
        class="card card--input"
        data-est-form
        novalidate
        aria-labelledby="est-input-title"
      >
        <div class="card__head">
          <span class="step" aria-hidden="true">
            {c["input.step"]}
          </span>
          <h2 class="card__title" id="est-input-title">
            {c["input.title"]}
          </h2>
        </div>

        <div class="field">
          <div class="field__top">
            <label class="field__label" for="est-volume">
              {c["volume.label"]}
            </label>
            <span class="badge">{c["input.required"]}</span>
          </div>
          <div class="chips" role="radiogroup" aria-label={c["volume.mode"]}>
            <span class="chips__label">{c["volume.mode"]}</span>
            <label class="chip">
              <input
                type="radio"
                name="mode"
                value="audits"
                checked
                data-est-mode
              />
              <span>{c["volume.mode.audits"]}</span>
            </label>
            <label class="chip">
              <input type="radio" name="mode" value="beds" data-est-mode />
              <span>{c["volume.mode.beds"]}</span>
            </label>
          </div>
          <div class="input">
            <input
              id="est-volume"
              class="input__control"
              type="text"
              inputmode="numeric"
              autocomplete="off"
              value={DEFAULT_AUDITS}
              data-est-volume
              data-audits={DEFAULT_AUDITS}
              data-beds={DEFAULT_BEDS}
            />
            <span class="input__unit" data-est-volume-unit>
              {c["volume.unit.audits"]}
            </span>
          </div>
          <p class="field__help" data-est-volume-help>
            {c["volume.help.audits"]}
          </p>
        </div>

        <div class="field">
          <div class="field__top">
            <label class="field__label" for="est-quote">
              {c["quote.label"]}
            </label>
            <span class="badge">{c["input.required"]}</span>
          </div>
          <div class="input">
            <input
              id="est-quote"
              class="input__control"
              type="text"
              inputmode="decimal"
              autocomplete="off"
              value={DEFAULT_QUOTE}
              data-est-quote
            />
            <span class="input__unit">%</span>
          </div>
          <p class="field__help">{c["quote.help"]}</p>
          <p class="field__band" data-est-band hidden></p>
        </div>

        <div class="divider">
          <span>{c["input.optional"]}</span>
        </div>

        <div class="field">
          <label class="field__label" for="est-state">
            {c["state.label"]}
          </label>
          <div class="input input--select">
            <select id="est-state" class="input__control" data-est-state>
              <option value="">{c["state.national"]}</option>
              {STATES.map((s) => (
                <option value={s.id}>{s.name}</option>
              ))}
            </select>
            <svg
              class="input__chevron"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </div>
          <p class="field__help" data-est-state-help></p>
        </div>

        <div class="field" data-est-uncapped-field data-active="false">
          <p class="field__label" id="est-uncapped-label">
            {c["uncapped.label"]}
          </p>
          <div
            class="chips chips--row"
            role="radiogroup"
            aria-labelledby="est-uncapped-label"
          >
            {UNCAPPED_OPTIONS.map((v) => (
              <label class="chip">
                <input
                  type="radio"
                  name="uncapped"
                  value={v}
                  checked={v === 40}
                  data-est-uncapped
                />
                <span>{pct(v)}</span>
              </label>
            ))}
          </div>
          <p class="field__help" data-est-uncapped-help>
            {c["uncapped.inactive"]}
          </p>
        </div>
      </form>

      <!-- ============ 2 · OUTPUT ============ -->
      <section class="card card--output" aria-labelledby="est-output-title">
        <div class="card__head">
          <span class="step" aria-hidden="true">
            {c["output.step"]}
          </span>
          <h2 class="card__title" id="est-output-title">
            {c["output.title"]}
          </h2>
        </div>

        <p class="empty" data-est-empty hidden>
          {c["output.empty"]}
        </p>

        <div class="stats" data-est-results>
          <div class="stat stat--loss">
            <p class="stat__label">{c["output.loss2026"]}</p>
            <p class="stat__value" data-out="loss2026">
              –
            </p>
            <p class="stat__sub" data-out="loss2026-sub"></p>
          </div>
          <div class="stat stat--loss">
            <p class="stat__label">{c["output.loss2027"]}</p>
            <p class="stat__value" data-out="loss2027">
              –
            </p>
            <p class="stat__sub" data-out="loss2027-sub"></p>
          </div>
          <div class="stat stat--small">
            <p class="stat__label">{c["output.quota"]}</p>
            <p class="stat__value stat__value--chips" data-out="quota">
              –
            </p>
            <p class="stat__sub">{c["output.quota.sub"]}</p>
          </div>
          <div class="stat stat--small">
            <p class="stat__label">{c["output.audits"]}</p>
            <p class="stat__value" data-out="audits">
              –
            </p>
            <p class="stat__sub">{c["output.audits.sub"]}</p>
          </div>
        </div>

        <div class="bars" data-est-chart>
          <p class="block-title">{c["chart.title"]}</p>
          <div class="bars__row">
            <span class="bars__label">{c["chart.2026"]}</span>
            <span class="bars__track">
              <span class="bars__fill bars__fill--loss" data-bar="2026"></span>
            </span>
            <span class="bars__value" data-out="bar2026">
              –
            </span>
          </div>
          <div class="bars__row">
            <span class="bars__label">{c["chart.2027"]}</span>
            <span class="bars__track">
              <span class="bars__fill bars__fill--loss" data-bar="2027"></span>
            </span>
            <span class="bars__value" data-out="bar2027">
              –
            </span>
          </div>
          <div class="bars__row">
            <span class="bars__label" data-out="bar-improved-label"></span>
            <span class="bars__track">
              <span
                class="bars__fill bars__fill--improved"
                data-bar="improved"
              ></span>
            </span>
            <span class="bars__value" data-out="bar-improved">
              –
            </span>
          </div>
        </div>

        <div class="gain" data-est-gain>
          <div class="gain__text">
            <p class="gain__eyebrow">{c["gain.eyebrow"]}</p>
            <p class="gain__title">
              {c["gain.title"].replace("{pp}", String(IMPROVEMENT_PP))}
            </p>
            <p class="gain__detail" data-out="gain-detail"></p>
          </div>
          <div class="gain__figure">
            <p class="gain__value" data-out="gain2027">
              –
            </p>
            <p class="gain__sub">{c["gain.value.sub"]}</p>
            <p class="gain__sub gain__sub--2026" data-out="gain2026"></p>
          </div>
        </div>

        <details class="method">
          <summary>{c["method.summary"]}</summary>
          <div class="method__scroll">
            <table class="method__table">
              <thead>
                <tr>
                  <th>{c["method.col.step"]}</th>
                  <th>{c["method.col.value"]}</th>
                  <th>{c["method.col.source"]}</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>{c["method.audits"]}</td>
                  <td data-out="m-audits">–</td>
                  <td data-out="m-audits-src"></td>
                </tr>
                <tr>
                  <td>{c["method.contested"]}</td>
                  <td data-out="m-contested">–</td>
                  <td>{c["method.contested.source"]}</td>
                </tr>
                <tr>
                  <td>{c["method.diff"]}</td>
                  <td data-out="m-diff">–</td>
                  <td data-out="m-diff-src"></td>
                </tr>
                <tr class="is-total">
                  <td>{c["method.loss2026"]}</td>
                  <td data-out="m-loss2026">–</td>
                  <td>{c["method.loss2026.source"]}</td>
                </tr>
                <tr>
                  <td>{c["method.factor"]}</td>
                  <td data-out="m-factor">–</td>
                  <td data-out="m-factor-src"></td>
                </tr>
                <tr class="is-total">
                  <td>{c["method.loss2027"]}</td>
                  <td data-out="m-loss2027">–</td>
                  <td>{c["method.loss2027.source"]}</td>
                </tr>
                <tr class="is-gain">
                  <td>{c["method.gain"]}</td>
                  <td data-out="m-gain">–</td>
                  <td data-out="m-gain-src"></td>
                </tr>
              </tbody>
            </table>
          </div>
        </details>

        <p class="sr-only" aria-live="polite" data-out="summary"></p>
      </section>
    </div>

    <div class="est-cta">
      <div>
        <p class="est-cta__title">{c["cta.title"]}</p>
        <p class="est-cta__body">{c["cta.body"]}</p>
      </div>
      <a
        class="est-book"
        href="https://cal.com/david-alesch/30min"
        data-booking
        aria-haspopup="dialog"
      >
        {t("cta.call")} <ArrowUpRight size={17} />
      </a>
    </div>

    <footer class="est-footnote">
      <span>{c["note.model"]}</span>
      <span>{c["note.sources"]}</span>
    </footer>
  </div>
</div>

<script>
  import {
    estimate,
    improve,
    STATES,
    MD_DIFF_2025,
    NATIONAL_DIFF_2025,
    BILLS_PER_BED,
    REALISED_RATE_2026,
    IMPROVEMENT_PP,
  } from "../lib/loss-model";
  import {
    estimatorCopy,
    type EstimatorKey,
    type EstimatorLang,
  } from "../i18n/estimator";

  const root = document.querySelector<HTMLElement>("[data-estimator]");
  if (root) init(root);

  function init(root: HTMLElement) {
    const lang = (root.dataset.lang === "de" ? "de" : "en") as EstimatorLang;
    const locale = lang === "de" ? "de-DE" : "en-GB";
    const c = (key: EstimatorKey, vars: Record<string, string> = {}) =>
      estimatorCopy[lang][key].replace(/\{(\w+)\}/g, (_, k) => vars[k] ?? "");
    const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const out = (name: string) => q<HTMLElement>(`[data-out="${name}"]`);

    const form = q<HTMLFormElement>("[data-est-form]");
    const volume = q<HTMLInputElement>("[data-est-volume]");
    const volumeUnit = q<HTMLElement>("[data-est-volume-unit]");
    const volumeHelp = q<HTMLElement>("[data-est-volume-help]");
    const quote = q<HTMLInputElement>("[data-est-quote]");
    const band = q<HTMLElement>("[data-est-band]");
    const state = q<HTMLSelectElement>("[data-est-state]");
    const stateHelp = q<HTMLElement>("[data-est-state-help]");
    const uncappedField = q<HTMLElement>("[data-est-uncapped-field]");
    const uncappedHelp = q<HTMLElement>("[data-est-uncapped-help]");
    const empty = q<HTMLElement>("[data-est-empty]");

    // ---- Formatting ----------------------------------------------------
    const int = new Intl.NumberFormat(locale, { maximumFractionDigits: 0 });
    const dec2 = new Intl.NumberFormat(locale, {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });
    const eur0 = new Intl.NumberFormat(locale, {
      style: "currency",
      currency: "EUR",
      maximumFractionDigits: 0,
    });
    const eur2 = new Intl.NumberFormat(locale, {
      style: "currency",
      currency: "EUR",
    });
    const pct = (v: number, digits = 1) => {
      const n = new Intl.NumberFormat(locale, {
        maximumFractionDigits: digits,
      }).format(v);
      return lang === "de" ? `${n} %` : `${n}%`;
    };
    /** Headline euro figures, rounded like the dashboard's tiles. */
    const money = (v: number) => {
      if (v >= 1_000_000) {
        const n = dec2.format(v / 1_000_000);
        return lang === "de" ? `≈ ${n} Mio. €` : `≈ €${n}m`;
      }
      return `≈ ${eur0.format(Math.round(v / 5000) * 5000)}`;
    };
    const tierText = (t: number | null) =>
      t === null ? c("output.uncapped") : pct(t);
    /** Same three-step colouring as the dashboard's tier chips. */
    const tierClass = (t: number | null) =>
      t === null || t >= 15 ? "t-critical" : t >= 10 ? "t-warning" : "t-good";
    const chip = (t: number | null) =>
      `<span class="tier-chip ${tierClass(t)}">${tierText(t)}</span>`;

    // ---- Parsing: 1.200 / 1,200 / 1 200 and 49,5 / 49.5 ---------------
    const parseCount = (s: string) => {
      if (!s.trim()) return null;
      const n = Number(s.replace(/[\s.,'’]/g, ""));
      return Number.isFinite(n) && n > 0 ? n : null;
    };
    const parseRate = (s: string) => {
      if (!s.trim()) return null;
      const n = Number(s.trim().replace("%", "").replace(",", "."));
      return Number.isFinite(n) && n >= 0 && n <= 100 ? n : null;
    };

    const checked = (name: string) =>
      form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)!
        .value;

    let mode = "audits";
    let announceTimer = 0;

    function switchMode(next: string) {
      if (next === mode) return;
      // Each mode remembers its own value.
      volume.dataset[mode] = volume.value;
      mode = next;
      volume.value = volume.dataset[mode] ?? "";
      volumeUnit.textContent = c(
        mode === "beds" ? "volume.unit.beds" : "volume.unit.audits",
      );
    }

    function render() {
      switchMode(checked("mode"));
      const count = parseCount(volume.value);
      const rate = parseRate(quote.value);
      const uncappedRate = Number(checked("uncapped"));
      quote.toggleAttribute(
        "aria-invalid",
        quote.value.trim() !== "" && rate === null,
      );
      volume.toggleAttribute(
        "aria-invalid",
        volume.value.trim() !== "" && count === null,
      );

      const row = STATES.find((s) => s.id === state.value);
      stateHelp.textContent = c("state.help", {
        diff: eur2.format(row ? MD_DIFF_2025[row.md] : NATIONAL_DIFF_2025),
        md: row ? `MD ${row.md}` : c("state.nationalMd"),
      });

      const r =
        rate === null || count === null
          ? null
          : estimate({
              quote: rate,
              audits: mode === "audits" ? count : null,
              beds: mode === "beds" ? count : null,
              state: state.value || null,
              uncappedRate,
            });

      volumeHelp.textContent =
        mode === "audits"
          ? c("volume.help.audits")
          : r
            ? c("volume.help.beds", { audits: int.format(r.audits) })
            : c("volume.help.bedsEmpty");

      const uncappedActive = r !== null && r.tier2027 === null;
      uncappedField.dataset.active = String(uncappedActive);
      form
        .querySelectorAll<HTMLInputElement>("[data-est-uncapped]")
        .forEach((i) => {
          i.disabled = !uncappedActive;
        });
      uncappedHelp.textContent = c(
        uncappedActive ? "uncapped.help" : "uncapped.inactive",
      );

      root.dataset.state = r ? "ready" : "empty";
      empty.hidden = r !== null;
      band.hidden = r === null;
      if (!r) return;

      const imp = improve(r, uncappedRate);
      band.innerHTML = c("quote.band", {
        from: chip(r.tier2026),
        to: chip(r.tier2027),
      });

      // Tiles.
      out("loss2026").textContent = money(r.loss2026);
      out("loss2026-sub").textContent = c("output.loss2026.sub", {
        contested: int.format(r.audits * r.contestedShare),
        diff: eur0.format(r.diff),
      });
      out("loss2027").textContent = money(r.loss2027);
      out("loss2027-sub").textContent =
        r.factor === 1
          ? c("output.loss2027.same")
          : c("output.loss2027.sub", {
              delta: `+${money(r.loss2027 - r.loss2026).replace("≈ ", "")}`,
            });
      out("quota").innerHTML =
        `${chip(r.tier2026)}<span class="arrow">→</span>${
          r.tier2027 === null
            ? `<span class="tier-chip t-critical">${c("output.uncappedAt", { rate: pct(r.rate2027) })}</span>`
            : chip(r.tier2027)
        }`;
      out("audits").textContent =
        `${int.format(r.audits)} → ${int.format(r.audits2027)}`;

      // Bars, all on the scale of the largest of the three.
      const max = Math.max(r.loss2026, r.loss2027, imp.loss2027, 1);
      const setBar = (key: string, v: number) => {
        q<HTMLElement>(`[data-bar="${key}"]`).style.width =
          `${(v / max) * 100}%`;
      };
      setBar("2026", r.loss2026);
      setBar("2027", r.loss2027);
      setBar("improved", imp.loss2027);
      out("bar2026").textContent = money(r.loss2026);
      out("bar2027").textContent = money(r.loss2027);
      out("bar-improved").textContent = money(imp.loss2027);
      out("bar-improved-label").textContent = c("chart.improved", {
        quote: pct(imp.quote),
      });

      // Potential.
      const from = pct(100 - r.contestedShare * 100);
      out("gain2027").textContent = `+${money(imp.gain2027).replace("≈ ", "")}`;
      out("gain2026").textContent = c("gain.2026", {
        gain: `+${money(imp.gain2026).replace("≈ ", "")}`,
      });
      out("gain-detail").textContent =
        imp.rate2027 === r.rate2027
          ? c("gain.detailSameTier", {
              from,
              to: pct(imp.quote),
              tier: tierText(r.tier2027),
            })
          : c("gain.detail", {
              from,
              to: pct(imp.quote),
              tierFrom: tierText(r.tier2027),
              tierTo: tierText(imp.tier2027),
            });

      // Rechenweg.
      out("m-audits").textContent = int.format(r.audits);
      out("m-audits-src").textContent = r.auditsEstimated
        ? c("method.audits.beds", {
            beds: int.format(count!),
            billsPerBed: dec2.format(BILLS_PER_BED),
            rate: pct(REALISED_RATE_2026[r.tier2026] * 100, 2),
            tier: pct(r.tier2026),
          })
        : c("method.audits.input");
      out("m-contested").textContent = pct(r.contestedShare * 100);
      out("m-diff").textContent = eur2.format(r.diff);
      out("m-diff-src").textContent = c("method.diff.source", {
        md: r.md ? `MD ${r.md}` : c("state.nationalMd"),
      });
      out("m-loss2026").textContent = eur0.format(r.loss2026);
      out("m-factor").textContent = `× ${dec2.format(r.factor)}`;
      out("m-factor-src").textContent =
        c("method.factor.source", {
          from: pct(r.cohort.from),
          to: tierText(r.tier2027),
          before: int.format(r.cohort.before),
          after: int.format(r.cohort.after),
        }) +
        (r.tier2027 === null
          ? c("method.factor.uncapped", { rate: pct(r.rate2027) })
          : "");
      out("m-loss2027").textContent = eur0.format(r.loss2027);
      out("m-gain").textContent = `+${eur0.format(imp.gain2027)}`;
      out("m-gain-src").textContent = c("method.gain.source", {
        quote: pct(imp.quote),
        rateFrom: pct(r.rate2027),
        rateTo: pct(imp.rate2027),
      });

      window.clearTimeout(announceTimer);
      announceTimer = window.setTimeout(() => {
        out("summary").textContent =
          `${c("output.loss2026")}: ${money(r.loss2026)}. ${c("output.loss2027")}: ${money(r.loss2027)}. ${c("gain.eyebrow")} (+${IMPROVEMENT_PP}): +${money(imp.gain2027)}.`;
      }, 700);
    }

    form.addEventListener("input", render);
    form.addEventListener("change", render);
    form.addEventListener("submit", (e) => e.preventDefault());
    volume.addEventListener("blur", () => {
      const n = parseCount(volume.value);
      if (n !== null) volume.value = int.format(n);
    });

    render();
  }
</script>

<style>
  /* Tokens mirrored from the dashboard (public/dashboard/index.html), which
     itself ports them from the Onsano Design System. Scoped to this page. */
  .est {
    --paper: #faf9f5;
    --paper-raised: #ffffff;
    --paper-sunken: #f0f2ec;
    --ink: #192f43;
    --ink-muted: #5b6e76;
    --line: #dce1de;
    --line-strong: #aeb8b2;
    --accent: #345c4b;
    --accent-wash: #e7eee2;
    --good: #3f7d63;
    --good-wash: #e5f1eb;
    --warning: #b45309;
    --warning-wash: #fdeae0;
    --critical: #b3402f;
    --critical-wash: #f6e9e6;
    --radius-xs: 0.5rem;
    --radius-sm: 0.75rem;
    --radius: 1.5rem;
    --font-mono: "Inter Variable", sans-serif;

    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 14px;
