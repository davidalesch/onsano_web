---
import Logo from './Logo.astro';
import CalButton from './CalButton.astro';
import { ChevronDown } from 'lucide-astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const locales: { code: Lang; label: string; href: string }[] = [
  { code: 'en', label: 'English', href: '/' },
  { code: 'de', label: 'Deutsch', href: '/de/' },
  { code: 'fr', label: 'Français', href: '/fr/' },
  { code: 'nl', label: 'Nederlands', href: '/nl/' },
  { code: 'it', label: 'Italiano', href: '/it/' },
  { code: 'es', label: 'Español', href: '/es/' },
];
const home = locales.find((l) => l.code === lang)?.href ?? '/';
const otherLocales = locales.filter((l) => l.code !== lang);

const nav = [
  { href: '#problem', label: t('nav.problem') },
  { href: '#approach', label: t('nav.approach') },
  { href: '#compliance', label: t('nav.compliance') },
  { href: '#contact', label: t('nav.contact') },
];
---
<header class="site-header" data-header>
  <div class="container-page site-header__inner">
    <a href={home} class="site-header__logo" aria-label="Onsano — home">
      <Logo class="logo" />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="site-header__actions">
      <details class="lang-switch" data-lang-switch>
        <summary aria-label="Change language">
          <span>{lang.toUpperCase()}</span>
          <ChevronDown class="lang-switch__chevron" width={14} height={14} stroke-width={2} aria-hidden="true" />
        </summary>
        <ul class="lang-switch__menu">
          {otherLocales.map((l) => (
            <li><a href={l.href} lang={l.code}>{l.label}</a></li>
          ))}
        </ul>
      </details>
      <div class="site-header__cta"><CalButton label={t('cta.call')} /></div>
    </div>
  </div>
</header>

<style>
  .site-header {
    /* Fixed and out of flow, so it overlays the page background (e.g. the hero's
       gradient wash) all the way to the top instead of reserving its own space. */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    transition: background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      backdrop-filter var(--dur-fast) var(--ease-out);
    border-bottom: 1px solid transparent;
  }
  /* Transparent at the top; on scroll the ribbon turns white with a hairline
     border and a soft shadow. Logo/nav/CTA keep their normal colours. */
  .site-header[data-scrolled] {
    background: color-mix(in srgb, var(--color-bg) 90%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom-color: var(--color-border);
    box-shadow: 0 1px 24px -14px rgb(11 15 20 / 0.28);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-h);
  }
  .site-header__logo { display: inline-flex; color: var(--color-brand); }

  .site-header__nav {
    display: none;
    gap: 2rem;
    font-size: 0.95rem;
  }
  /* One clean, uniform hover cue used everywhere in the header: a hairline
     underline grows in from the center, brand-green, under the text colour
     shifting to brand-blue. Same language as the CTA's hover treatment. */
  .site-header__nav a {
    position: relative;
    display: inline-block;
    color: var(--color-muted);
    text-decoration: none;
    padding-bottom: 0.35rem;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .site-header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 1px;
    background: var(--color-brand-green);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .site-header__nav a:hover,
  .site-header__nav a:focus-visible { color: var(--color-brand); }
  .site-header__nav a:hover::after,
  .site-header__nav a:focus-visible::after {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header__nav a::after { transition: none; }
  }

  .site-header__actions { display: flex; align-items: center; gap: 1rem; }

  /* Language switcher: a native <details> disclosure, styled as a small pill
     trigger + dropdown menu. No JS required for the core interaction. */
  .lang-switch {
    position: relative;
  }
  .lang-switch summary {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.375rem 0.5rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    list-style: none;
    transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .lang-switch summary::-webkit-details-marker { display: none; }
  .lang-switch summary:hover,
  .lang-switch[open] summary {
    color: var(--color-brand);
    background: var(--color-brand-100);
  }
  .lang-switch__chevron {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .lang-switch[open] .lang-switch__chevron { transform: rotate(180deg); }

  .lang-switch__menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 10;
    min-width: 9rem;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: 0 12px 32px -12px rgb(11 15 20 / 0.28);
  }
  .lang-switch__menu a {
    position: relative;
    display: block;
    padding: 0.45rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .lang-switch__menu a:hover,
  .lang-switch__menu a:focus-visible {
    color: var(--color-brand);
    background: var(--color-brand-100);
  }

  .site-header__cta { display: none; }

  @media (min-width: 900px) {
    .site-header__nav { display: flex; }
    .site-header__cta { display: block; }
  }
</style>

<script>
  // Add a subtle background once the user scrolls past the hero top.
  const header = document.querySelector('[data-header]');
  const onScroll = () => {
    if (window.scrollY > 4) header?.setAttribute('data-scrolled', '');
    else header?.removeAttribute('data-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Close the language menu on outside click or Escape — <details> handles
  // the open/close toggle natively, this just tidies up dismissal.
  const langSwitch = document.querySelector('[data-lang-switch]');
  document.addEventListener('click', (e) => {
    if (langSwitch instanceof HTMLDetailsElement && langSwitch.open && !langSwitch.contains(e.target as Node)) {
      langSwitch.open = false;
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && langSwitch instanceof HTMLDetailsElement) {
      langSwitch.open = false;
    }
  });
</script>
