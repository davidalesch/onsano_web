---
import Logo from "./Logo.astro";
import { ArrowUpRight, ChevronDown, Menu } from "lucide-astro";
import { languages, type Lang } from "../i18n/ui";
import { productCopy } from "../i18n/product";
const { lang } = Astro.props as { lang: Lang };
const c = productCopy(lang);
const home = lang === "en" ? "/" : `/${lang}/`;
const pathname = Astro.url.pathname.replace(/\/+$/, "");
const legal = pathname.endsWith("/impressum")
  ? "impressum/"
  : pathname.endsWith("/datenschutz")
    ? "datenschutz/"
    : "";
const links = [
  { id: "products", label: c.products },
  { id: "approach", label: c.workflow },
  { id: "compliance", label: c.trust },
];
---

<header class="rev-header">
  <div class="rev-header-inner">
    <a href={home} class="brand-link" aria-label="Onsano home">
      <Logo class="logo" />
    </a>
    <nav aria-label="Primary" class="desktop-nav">
      {links.map((l) => (
        <a href={`${home}#${l.id}`}>{l.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <details class="language-menu">
        <summary aria-label="Change language">
          {lang.toUpperCase()}
          <ChevronDown size={12} />
        </summary>
        <div>
          {Object.entries(languages)
            .filter(([code]) => code !== lang)
            .map(([code, name]) => (
              <a
                lang={code}
                href={`${code === "en" ? "/" : `/${code}/`}${legal}`}
              >
                {name}
              </a>
            ))}
        </div>
      </details>
      <a
        href="https://cal.com/david-alesch/30min"
        data-booking
        aria-haspopup="dialog"
        class="header-book"
      >
        {c.book}
        <ArrowUpRight size={15} />
      </a>
      <details class="mobile-menu">
        <summary aria-label={c.menuLabel}>
          <Menu size={21} />
        </summary>
        <nav aria-label="Mobile">
          {links.map((l) => (
            <a href={`${home}#${l.id}`}>{l.label}</a>
          ))}
          <a
            href="https://cal.com/david-alesch/30min"
            data-booking
            aria-haspopup="dialog"
          >
            {c.book}
            <ArrowUpRight size={15} />
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
<style>
  .rev-header {
    position: fixed;
    z-index: 50;
    top: 0;
    left: 0;
    right: 0;
    background: #faf9f5ed;
    backdrop-filter: blur(16px);
    border-bottom: 1px solid #dce1de85;
  }
  .rev-header-inner {
    max-width: 1440px;
    padding: 0 48px;
    height: 80px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }
  .brand-link {
    color: #1d3546;
    --logo-gap: #faf9f5;
    display: block;
  }
  .brand-link :global(.logo) {
    height: 44px;
  }
  .desktop-nav {
    display: flex;
    gap: 29px;
    font-size: 12px;
  }
  .desktop-nav a,
  .header-actions a {
    color: #263f4d;
    text-decoration: none;
  }
  .desktop-nav a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .language-menu {
    position: relative;
  }
  .language-menu summary {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    cursor: pointer;
    list-style: none;
  }
  .language-menu summary::-webkit-details-marker,
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .language-menu > div {
    position: absolute;
    right: 0;
    top: 30px;
    background: #fffefb;
    border: 1px solid #dce1de;
    padding: 10px;
    border-radius: 8px;
    min-width: 130px;
    box-shadow: 0 10px 20px #18324315;
  }
  .language-menu a {
    display: block;
    padding: 7px;
    font-size: 12px;
  }
  .language-menu a:hover {
    background: #e7eee2;
    border-radius: 4px;
  }
  .header-book {
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: 11px;
    padding: 10px 16px;
    border: 1px solid #b7c4bc;
    border-radius: 30px;
  }
  .header-book:hover {
    background: #e2eadc;
  }
  .mobile-menu {
    display: none;
  }
  .mobile-menu summary {
    list-style: none;
    cursor: pointer;
  }
  .mobile-menu nav {
    position: absolute;
    top: 70px;
    left: 15px;
    right: 15px;
    background: #fffefb;
    padding: 15px;
    border: 1px solid #dce1de;
    border-radius: 12px;
    box-shadow: 0 16px 30px #19334315;
  }
  .mobile-menu a {
    display: flex;
    padding: 14px;
    align-items: center;
    justify-content: space-between;
    font-size: 14px;
  }
  @media (max-width: 1050px) {
    .rev-header-inner {
      padding-inline: 32px;
      gap: 20px;
    }
    .desktop-nav {
      gap: 20px;
      font-size: 11px;
    }
    .header-actions {
      gap: 15px;
    }
  }
  @media (max-width: 760px) {
    .rev-header-inner {
      height: 70px;
      padding-inline: 26px;
    }
    .desktop-nav {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    .header-book {
      font-size: 10px;
      padding: 8px 12px;
      gap: 10px;
    }
    .brand-link :global(.logo) {
      height: 38px;
    }
  }
  @media (max-width: 480px) {
    .rev-header-inner {
      padding-inline: 20px;
      gap: 12px;
    }
    .header-book {
      display: none;
    }
    .header-actions {
      gap: 20px;
    }
  }
</style>
<script>
  const menus = document.querySelectorAll<HTMLDetailsElement>(
    ".rev-header details",
  );
  menus.forEach((menu) =>
    menu.addEventListener("toggle", () => {
      if (menu.open)
        menus.forEach((other) => {
          if (other !== menu) other.open = false;
        });
    }),
  );
  document.addEventListener("click", (e) =>
    menus.forEach((menu) => {
      if (!menu.contains(e.target as Node)) menu.open = false;
    }),
  );
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape")
      menus.forEach((menu) => {
        if (menu.open) {
          menu.open = false;
          menu.querySelector("summary")?.focus();
        }
      });
  });
  document
    .querySelectorAll(".mobile-menu a")
    .forEach((link) =>
      link.addEventListener("click", () =>
        menus.forEach((menu) => (menu.open = false)),
      ),
    );
</script>
