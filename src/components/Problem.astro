---
import CaseIntegrity from './CaseIntegrity.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section id="problem" class="problem">
  <div class="container-page problem__grid">
    <div class="problem__text">
      <p class="problem__kicker sd-rise" style="--sd-range: entry 2% cover 18%">{t('problem.kicker')}</p>
      <h2 class="problem__title sd-rise" style="--sd-range: entry 4% cover 24%">{t('problem.title')}</h2>
      <p class="problem__body sd-rise" style="--sd-range: entry 8% cover 30%">{t('problem.body')}</p>
    </div>

    <div class="problem__visual">
      <CaseIntegrity class="problem__figure" />
    </div>
  </div>
</section>

<style>
  .problem {
    padding-block: var(--spacing-section);
  }
  .problem__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
    width: 100%;
  }
  .problem__kicker {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-green-ink);
    margin: 0 0 1rem;
  }
  .problem__title {
    font-size: var(--text-h2);
    line-height: 1.15;
    max-width: 18ch;
    margin: 0 0 1.5rem;
  }
  .problem__body {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 46ch;
    margin: 0;
  }
  .problem__visual {
    display: flex;
    justify-content: center;
  }
  .problem__visual :global(.problem__figure) {
    width: 100%;
    max-width: 24rem;
    height: auto;
  }

  @media (min-width: 860px) {
    .problem__grid { grid-template-columns: 1.1fr 0.9fr; }
  }
</style>
