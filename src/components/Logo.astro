---
/** Official supplied wordmark, kept as an SVG asset so its lettering is exact. */
interface Props {
  class?: string;
  title?: string;
}
const { class: className = "", title = "Onsano" } = Astro.props;
---

<img
  src="/brand/onsano-wordmark.svg"
  width="1263"
  height="356"
  class={className}
  alt={title}
  decoding="async"
/>
