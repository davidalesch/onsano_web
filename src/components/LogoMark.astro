---
/** Official standalone mark and white-on-blue tile supplied with the new brand. */
interface Props {
  class?: string;
  title?: string;
  variant?: "mark" | "tile";
}
const { class: className = "", title = "", variant = "mark" } = Astro.props;
---

<img
  src={
    variant === "tile"
      ? "/brand/onsano-mark-tile.svg"
      : "/brand/onsano-mark.svg"
  }
  width={variant === "tile" ? 406 : 381}
  height={variant === "tile" ? 400 : 270}
  class={className}
  alt={title}
  decoding="async"
/>
