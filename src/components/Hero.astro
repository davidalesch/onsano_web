---
import { Layers, ChevronDown } from 'lucide-astro';
import CalButton from './CalButton.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="hero" data-hero>
  <!-- Brand gradient wash. -->
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__wash"></div>
  </div>

  <!-- Beat 1: the held statement — all you see on load. -->
  <div class="hero__statement">
    <div class="container-page hero__statement-inner">
      <h1 class="hero__title">
        <span class="hero__line">{t('hero.title.line1')}</span>
        <span class="hero__line">{t('hero.title.line2')}</span>
      </h1>
      <p class="hero__subtitle">{t('hero.subtitle')}</p>
    </div>
    <a href="#value" class="hero__scroll" aria-label={t('hero.scroll')}>
      <span>{t('hero.scroll')}</span>
      <ChevronDown width={18} height={18} stroke-width={2} aria-hidden="true" />
    </a>
  </div>

  <!-- Beat 2: supporting value block — reveals with scroll as you leave beat 1. -->
  <div class="container-page hero__value" id="value">
    <p class="hero__eyebrow sd-rise" style="--sd-range: entry 1% cover 20%">
      <Layers width={16} height={16} stroke-width={2} aria-hidden="true" />
      <span>{t('hero.eyebrow')}</span>
    </p>
    <p class="hero__lead sd-rise" style="--sd-range: entry 4% cover 26%">{t('hero.lead')}</p>
    <div class="hero__cta sd-rise" style="--sd-range: entry 8% cover 32%">
      <CalButton label={t('cta.call')} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Cancel main's top padding so the gradient wash reaches true page-top,
       behind the fixed/transparent header, instead of starting below it. */
    margin-top: calc(-1 * var(--header-h));
  }

  /* --- Background: gradient wash + subtle squares --- */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .hero__wash {
    position: absolute;
    inset: -10%;
    background:
      radial-gradient(48% 44% at 22% 26%,
        color-mix(in srgb, var(--color-brand) 20%, transparent), transparent 70%),
      radial-gradient(46% 46% at 82% 72%,
        color-mix(in srgb, var(--color-brand-green) 26%, transparent), transparent 72%),
      radial-gradient(40% 40% at 60% 8%,
        color-mix(in srgb, var(--color-brand-green) 12%, transparent), transparent 70%);
    filter: blur(10px);
  }
  /* --- Beat 1: statement --- */
  .hero__statement {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .hero__statement-inner { will-change: opacity, transform; }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-brand);
    font-size: clamp(2.75rem, 1.6rem + 4.6vw, 4.5rem);
    line-height: 1.08;
    max-width: min(100%, 66rem);
    margin: 0 auto;
  }
  .hero__line { display: block; }

  .hero__subtitle {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-green-ink);
    margin: 1.25rem auto 0;
  }

  .hero__scroll {
    position: absolute;
    bottom: 2.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .hero__scroll:hover { color: var(--color-brand); }

  /* --- Beat 2: value block --- */
  .hero__value {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
    padding-block: clamp(1rem, 4vw, 4rem) var(--spacing-section);
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    background: var(--color-green-100);
    color: var(--color-green-ink);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .hero__lead {
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--color-muted);
    max-width: 46ch;
    margin: 0 auto;
  }

  /* --- Motion --- */
  @media (prefers-reduced-motion: no-preference) {
    .hero__scroll svg { animation: nudge 2.4s var(--ease-out) 1.2s infinite; }
    .hero__wash { animation: wash-drift 26s ease-in-out infinite alternate; }

    /* Statement recedes as you scroll the first viewport (JS-free, scroll-linked).
       Chromium/most Chrome+Edge users get this; others just keep it static. */
    @supports (animation-timeline: scroll()) {
      .hero__statement-inner {
        animation: statement-recede linear both;
        animation-timeline: scroll(root);
        animation-range: 0 85svh;
      }
      .hero__scroll {
        animation: cue-fade linear both;
        animation-timeline: scroll(root);
        animation-range: 0 30svh;
      }
    }
  }

  @keyframes statement-recede {
    to { opacity: 0; transform: translateY(-4vh) scale(0.965); filter: blur(3px); }
  }
  @keyframes cue-fade { to { opacity: 0; transform: translate(-50%, 12px); } }
  @keyframes nudge {
    0%, 100% { transform: translateY(0); opacity: 0.85; }
    50% { transform: translateY(3px); opacity: 1; }
  }
  @keyframes wash-drift {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(-3%, 2%, 0) scale(1.08); }
  }
</style>
